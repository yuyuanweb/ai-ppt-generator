# 运行环境：development / production 等
APP_ENV=development

# 异步 PostgreSQL 连接串（宿主机端口 39432，对应 docker-compose 映射）
DATABASE_URL=postgresql+asyncpg://aippt:aippt@localhost:39432/aippt

# Redis 连接串（宿主机端口 39379，对应 docker-compose 映射）
REDIS_URL=redis://localhost:39379/0

# DeepSeek 使用 OpenAI 兼容接口；密钥只写入本地 .env，不得提交
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# 默认关闭思考模式以缩短大纲等待时间，复杂主题可按需开启
LLM_THINKING_ENABLED=false
LLM_TIMEOUT_SECONDS=60

# AI 生图；与 LLM 凭证独立，可不配。IMAGE_PROVIDER=openai | bailian
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
# 百炼示例（qwen-image-3.0 不走 OpenAI 兼容模式）：
# IMAGE_PROVIDER=bailian
# IMAGE_API_KEY=sk-xxx
# IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# IMAGE_MODEL=qwen-image-3.0
# 可选：业务空间 ID，填写后改用 https://{id}.cn-beijing.maas.aliyuncs.com/api/v1
IMAGE_WORKSPACE_ID=
IMAGE_TIMEOUT_SECONDS=60

# Unsplash 图库 Access Key；生图不可用时降级到此，也可单独使用
UNSPLASH_ACCESS_KEY=

# 单张配图体积上限（MB）
MAX_IMAGE_MB=8

# 允许跨域的前端源列表（JSON 数组）
CORS_ORIGINS=["http://localhost:39173"]

# JWT 签名密钥（HS256）。生产环境必须替换，可用：openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me

# JWT 签名算法
JWT_ALGORITHM=HS256

# access token 过期时间（分钟），默认 7 天；本项目不做 refresh token
JWT_EXPIRE_MINUTES=10080

# 对象存储驱动：local 落盘到 backend/var/storage，cos 走腾讯云
# 选 cos 需额外安装 SDK：uv add cos-python-sdk-v5
STORAGE_DRIVER=local
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=

# 单个上传文件的体积上限（MB）
MAX_UPLOAD_MB=10

# ---- 钱包与支付 ----
# 充值总开关；关闭时余额仍可查看，只是不能下单
PAYMENT_ENABLED=false
# mock（本地联调，不调网关）| easypay（易支付协议聚合通道，支持 alipay / wxpay）
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=CNY
# 站点对外根地址，用于拼支付回调 notify_url / return_url（生产必须是公网可达的 https 地址）
PAYMENT_PUBLIC_BASE_URL=http://localhost:39173
PAYMENT_MIN_AMOUNT=1
PAYMENT_MAX_AMOUNT=10000
# 单用户每日充值上限（元），0 = 不限
PAYMENT_DAILY_LIMIT=0
PAYMENT_ORDER_TIMEOUT_MINUTES=30
PAYMENT_MAX_PENDING_ORDERS=3
# 手续费率（百分比，如 0.6 表示 0.6%）；到账倍率（1.1 表示充 100 到账 110）
PAYMENT_FEE_RATE=0
PAYMENT_RECHARGE_MULTIPLIER=1
# 每生成一页扣多少余额；0 表示免费
CHARGE_PER_PAGE=0

# 易支付商户参数（PAYMENT_PROVIDER=easypay 时必填）
EASYPAY_PID=
EASYPAY_KEY=
EASYPAY_API_BASE=https://pay.example.com
# api = 服务端 mapi.php 下单取二维码；submit = 拼 submit.php 让浏览器跳转
EASYPAY_MODE=api
